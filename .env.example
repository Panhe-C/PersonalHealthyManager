# SQLite (current default; tests run against this).
DATABASE_URL="file:./dev.db"
SESSION_SECRET="development-secret-32-bytes-long-2026"
SETTINGS_ENCRYPTION_KEY="development-settings-key-32byte!"

# One-time personal owner bootstrap (`npm run owner:setup`).
HBM_OWNER_EMAIL="you@example.com"
HBM_OWNER_PASSWORD="replace-with-a-strong-password"
HBM_OWNER_TIMEZONE="Asia/Shanghai"
HBM_LARK_CLI_PATH="lark-cli"
HBM_LARK_CALENDAR_ID="primary"
HBM_AUTOMATION_INTERVAL_MS="900000"

# Mobile release configuration. Local development falls back to app.json.
EXPO_PUBLIC_API_BASE_URL="https://api.example.com"
EXPO_PUBLIC_EAS_PROJECT_ID="00000000-0000-4000-8000-000000000000"
EXPO_IOS_BUNDLE_IDENTIFIER="com.example.healthybodymanager"
EXPO_ANDROID_PACKAGE="com.example.healthybodymanager"
EXPO_APPLE_TEAM_ID="ABCDE12345"

# Single-instance production uses a persistent volume:
# DATABASE_URL="file:/data/healthy-body.sqlite"
#
# Postgres is a future multi-instance target. Changing only DATABASE_URL is not
# sufficient: prisma/schema.prisma and the migration history must be converted
# and tested before using the optional local Postgres service in docker-compose.yml.
# DATABASE_URL="postgresql://hbm:hbm@localhost:5432/hbm?schema=public"
