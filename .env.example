# SQLite (current default; tests run against this).
DATABASE_URL="file:./dev.db"
SETTINGS_ENCRYPTION_KEY="development-settings-key-32byte!"

# One-time personal owner bootstrap (`npm run owner:setup`). Accounts created
# this way are treated as email-verified and skip the self-service flow.
HBM_OWNER_EMAIL="you@example.com"
HBM_OWNER_PASSWORD="replace-with-a-strong-password"
HBM_OWNER_TIMEZONE="Asia/Shanghai"

# Self-service registration and public links use this canonical origin.
HBM_APP_BASE_URL="http://localhost:3000"
HBM_PUBLIC_BASE_URL="http://localhost:3000"
# Development defaults to enabled when unset. Production Compose defaults to
# false; set true only when this deployment intentionally accepts new users.
HBM_REGISTRATION_ENABLED="true"
# Keep production bound to localhost behind a reverse proxy by default. Set
# 0.0.0.0 only for a deliberate temporary IP:port deployment.
# HBM_BIND_ADDRESS="127.0.0.1"
# HBM_PORT="3000"

# Public policy metadata, shown on /privacy and /terms and referenced in the
# register agreement. release:check flags these as missing when unset; local
# development renders visible placeholders so the pages still work.
# HBM_OPERATOR_NAME="Your Name / Entity"
# HBM_PRIVACY_EMAIL="privacy@example.com"
# HBM_POLICY_EFFECTIVE_DATE="2026-08-01"
# HBM_DEPLOYMENT_REGION="e.g. 中国大陆 / US-East"
# Production canonical origin for both values:
# HBM_APP_BASE_URL="https://www.cbhdev.xyz"
# HBM_PUBLIC_BASE_URL="https://www.cbhdev.xyz"

# Structured error forwarding (optional). Logs are always JSON on stdout; when
# set, error-level events are also POSTed here after redaction.
# HBM_ERROR_WEBHOOK_URL="https://hooks.example.com/hbm-errors"

# Shared rate limiting for multi-instance deployments (Upstash-compatible HTTP).
# Single-instance installs can leave these unset and keep the in-memory store.
# HBM_RATE_LIMIT_REDIS_URL="https://xxxxx.upstash.io"
# HBM_RATE_LIMIT_REDIS_TOKEN="..."

# Feishu / Lark app for per-user calendar OAuth. Without these, calendar
# write-back stays on the single-account lark-cli path gated by
# HBM_LARK_CALENDAR_ACCOUNT_EMAIL.
# HBM_FEISHU_APP_ID=""
# HBM_FEISHU_APP_SECRET=""

# Backup retention (days), production host bind directory, and optional local
# offsite directory for copies. The production backup container only receives
# the retention value; offsite encryption/sync is an independent host job.
# HBM_BACKUP_RETENTION_DAYS="14"
# HBM_DATA_HOST_DIR="/srv/healthy-body-manager/data"
# HBM_BACKUP_HOST_DIR="/srv/healthy-body-manager/backups"
# HBM_DEBIAN_MIRROR="http://mirrors.cloud.aliyuncs.com"
# HBM_BACKUP_OFFSITE_DIR="/Volumes/offsite/hbm-backups"
# HBM_BACKUP_INTERVAL_SECONDS="86400"

# "console" prints password-recovery emails to the server log. Direct
# registration does not require email delivery. Select "smtp" and configure all
# settings below when real password-recovery delivery is required.
HBM_EMAIL_TRANSPORT="console"
HBM_EMAIL_FROM="Healthy Body Manager <no-reply@example.com>"
# HBM_SMTP_HOST="smtp.example.com"
# HBM_SMTP_PORT="587"
# HBM_SMTP_SECURE="false"
# HBM_SMTP_USER="apikey"
# HBM_SMTP_PASSWORD="replace-with-the-smtp-password"

# Where the MCP OAuth callback sends the browser when the login was started from
# the iOS app. Must match the app's URL scheme, otherwise the in-app browser has
# no way to recognise the end of the flow and stays open.
# HBM_APP_OAUTH_RETURN_URL="hbm://mcp-oauth"

HBM_LARK_CLI_PATH="lark-cli"
HBM_LARK_CALENDAR_ID="primary"

# Calendar write-back uses this server's own lark-cli login and the single
# calendar above, so any account that confirms a draft would create the event on
# the deployer's calendar. Name the one account allowed to use it. Leaving this
# unset disables write-back rather than writing to the wrong calendar.
# HBM_LARK_CALENDAR_ACCOUNT_EMAIL="you@example.com"
HBM_AUTOMATION_INTERVAL_MS="900000"

# Mobile release configuration. Local development falls back to app.json.
EXPO_PUBLIC_API_BASE_URL="https://www.cbhdev.xyz"
EXPO_PUBLIC_EAS_PROJECT_ID="00000000-0000-4000-8000-000000000000"
EXPO_PUBLIC_REGISTRATION_ENABLED="false"
EXPO_IOS_BUNDLE_IDENTIFIER="com.example.healthybodymanager"
EXPO_ANDROID_PACKAGE="com.example.healthybodymanager"
EXPO_APPLE_TEAM_ID="ABCDE12345"

# Single-instance production uses a persistent volume:
# DATABASE_URL="file:/data/healthy-body.sqlite"
#
# Postgres is a future multi-instance target. Changing only DATABASE_URL is not
# sufficient: prisma/schema.prisma and the migration history must be converted
# and tested before using the optional local Postgres service in docker-compose.yml.
# DATABASE_URL="postgresql://hbm:hbm@localhost:5432/hbm?schema=public"
